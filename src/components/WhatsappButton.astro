---
const message = encodeURIComponent("Hola, quisiera realizar una consulta legal.");
const href = `https://wa.me/51925295238?text=${message}`;
---
<div class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 flex items-center gap-3 group">
  <!-- Mensaje de apoyo: aparece con hover o foco de teclado (el enlace ya tiene aria-label) -->
  <div
    aria-hidden="true"
    class="hidden md:block max-w-[16rem] bg-surface border border-outline-variant/40 shadow-xl px-4 py-3 opacity-0 translate-x-2 transition-all duration-300 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 group-focus-within:opacity-100 group-focus-within:translate-x-0 motion-reduce:transition-none"
  >
    <p class="font-subheading-caps text-label-sm text-primary uppercase tracking-widest">Atención confidencial</p>
    <p class="font-body-md text-label-sm text-on-surface-variant mt-1 normal-case tracking-normal font-normal">
      ¿Necesita orientación legal? Escríbanos por WhatsApp.
    </p>
  </div>

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar al estudio por WhatsApp (se abre en una pestaña nueva)"
    class="relative bg-tertiary-container text-on-tertiary-container rounded-full w-14 h-14 flex items-center justify-center shadow-xl hover:scale-110 active:scale-95 transition-transform duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tertiary motion-reduce:transition-none motion-reduce:hover:scale-100"
  >
    <span class="absolute inset-0 rounded-full bg-tertiary-container opacity-30 motion-safe:animate-ping" aria-hidden="true"></span>
    <svg class="relative w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.23 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"/>
    </svg>
  </a>
</div>
