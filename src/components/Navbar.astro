---
interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const links = [
  { text: "Inicio", href: "/" },
  { text: "Equipo", href: "/equipo" },
  { text: "Áreas", href: "/areas" },
  { text: "Trabaja con nosotros", href: "/trabaja" },
];
---

<nav
  id="main-navbar"
  data-scrolled="false"
  data-hidden="false"
  class="bg-surface text-primary w-full top-0 sticky border-b border-outline-variant z-50 transition-[transform,background-color,box-shadow,backdrop-filter] duration-300 data-[scrolled=true]:bg-surface/85 data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:shadow-sm data-[hidden=true]:-translate-y-full motion-reduce:transition-none"
>
  <div
    class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-unit max-w-container-max mx-auto w-full"
  >
    <!-- Brand -->
    <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
      <img
        src="/images/logo_header_new.png"
        alt="Arias & Zereceda"
        class="h-20 md:h-24 w-auto"
      />
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex gap-4 lg:gap-8 items-center">
      {
        links.map((link) => {
          const isActive =
            currentPage === link.href ||
            (currentPage === "" && link.href === "/");
          return (
            <li>
              <a
                href={link.href}
                class={`font-subheading-caps text-subheading-caps hover:text-primary transition-colors duration-300 ${
                  isActive
                    ? "text-primary font-bold border-b border-primary pb-1"
                    : "text-on-surface-variant"
                }`}
              >
                {link.text}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Trailing Action -->
    <div class="hidden md:flex">
      <a
        href="/contacto"
        class="btn-primary py-3 px-5 text-xs whitespace-nowrap flex items-center justify-center"
      >
        Contáctanos
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="md:hidden text-on-surface p-2 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
    >
      <span class="material-symbols-outlined text-2xl">menu</span>
    </button>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-surface border-t border-outline-variant absolute w-full left-0 shadow-lg"
  >
    <ul class="flex flex-col py-4">
      {
        links.map((link) => {
          const isActive =
            currentPage === link.href ||
            (currentPage === "" && link.href === "/");
          return (
            <li>
              <a
                href={link.href}
                class={`block px-margin-mobile py-4 font-subheading-caps text-subheading-caps transition-colors ${
                  isActive
                    ? "bg-surface-variant text-primary font-bold border-l-4 border-primary"
                    : "text-on-surface-variant hover:bg-surface-variant hover:text-primary"
                }`}
              >
                {link.text}
              </a>
            </li>
          );
        })
      }
      <li class="px-margin-mobile py-4 mt-2">
        <a
          href="/contacto"
          class="btn-primary py-3 px-6 text-center w-full block"
        >
          Contáctanos
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const navbar = document.getElementById("main-navbar");
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const setMenu = (open: boolean) => {
    if (!toggleBtn || !menu) return;
    menu.classList.toggle("hidden", !open);
    toggleBtn.setAttribute("aria-expanded", String(open));
    toggleBtn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    const icon = toggleBtn.querySelector("span");
    if (icon) icon.textContent = open ? "close" : "menu";
    // Con el menú abierto la barra debe permanecer visible
    if (open && navbar) navbar.dataset.hidden = "false";
  };

  toggleBtn?.addEventListener("click", () => {
    setMenu(menu?.classList.contains("hidden") ?? false);
  });

  // Barra inteligente: vidrio al hacer scroll, se oculta al bajar y reaparece al subir
  if (navbar) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const menuOpen = menu ? !menu.classList.contains("hidden") : false;

      navbar.dataset.scrolled = String(y > 40);

      const delta = y - lastY;
      if (Math.abs(delta) > 6) {
        navbar.dataset.hidden = String(delta > 0 && y > 200 && !menuOpen);
        lastY = y;
      }
      if (y <= 200) navbar.dataset.hidden = "false";
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );

    // Si el foco entra a la barra con el teclado, que se muestre
    navbar.addEventListener("focusin", () => {
      navbar.dataset.hidden = "false";
    });

    update();
  }
</script>
